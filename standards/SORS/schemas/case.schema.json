{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Shenyan-kosmoX/community/blob/main/standards/SORS/schemas/case.schema.json",
  "title": "SORS 0.1 case index",
  "$defs": {
    "record": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": true,
          "not": {
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "properties": {
                  "availability": {
                    "const": "not_bundled"
                  }
                },
                "required": [
                  "availability"
                ]
              }
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "locator": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": true,
          "not": {
            "anyOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "properties": {
                  "availability": {
                    "const": "not_bundled"
                  }
                },
                "required": [
                  "availability"
                ]
              }
            ]
          }
        },
        {
          "type": "object",
          "properties": {
            "availability": {
              "const": "not_bundled"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "retrieval": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "availability",
            "description",
            "retrieval"
          ],
          "additionalProperties": true,
          "not": {
            "anyOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "url"
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "kind": {
      "const": "case"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "stage": {
      "enum": [
        "planned",
        "in_progress",
        "results_available"
      ]
    },
    "question": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "record": {
          "$ref": "#/$defs/record"
        }
      },
      "required": [
        "summary"
      ],
      "additionalProperties": true
    },
    "capability_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "uniqueItems": true
    },
    "model": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "record": {
          "$ref": "#/$defs/record"
        }
      },
      "required": [
        "description"
      ],
      "additionalProperties": true
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "record": {
            "$ref": "#/$defs/record"
          },
          "availability": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": true
      },
      "minItems": 0
    },
    "execution": {
      "type": "object",
      "properties": {
        "environment_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "role": {
                "enum": [
                  "prepare",
                  "plan",
                  "run",
                  "check",
                  "plot"
                ]
              },
              "mode": {
                "enum": [
                  "command",
                  "documented"
                ]
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1
              },
              "instructions": {
                "$ref": "#/$defs/record"
              },
              "environment_ref": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "uniqueItems": true
              },
              "output_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "uniqueItems": true
              },
              "input_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "uniqueItems": true
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400
              }
            },
            "required": [
              "id",
              "role",
              "mode"
            ],
            "additionalProperties": true,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "command"
                    }
                  }
                },
                "then": {
                  "required": [
                    "argv"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "documented"
                    }
                  }
                },
                "then": {
                  "required": [
                    "instructions"
                  ]
                }
              }
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "environment_ref",
        "cwd",
        "steps"
      ],
      "additionalProperties": true
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "record": {
            "$ref": "#/$defs/record"
          },
          "format": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": true
      },
      "minItems": 0
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "record": {
            "$ref": "#/$defs/record"
          }
        },
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": true
      },
      "minItems": 0
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "representation": {
            "enum": [
              "documented",
              "structured",
              "pending"
            ]
          },
          "record": {
            "$ref": "#/$defs/record"
          }
        },
        "required": [
          "id",
          "description",
          "representation"
        ],
        "additionalProperties": true
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "criterion_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "uniqueItems": true
          },
          "reference_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "uniqueItems": true
          },
          "output_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "uniqueItems": true
          },
          "input_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "uniqueItems": true
          },
          "implementation": {
            "$ref": "#/$defs/record"
          },
          "record": {
            "$ref": "#/$defs/record"
          }
        },
        "required": [
          "id",
          "method",
          "criterion_refs",
          "reference_refs",
          "output_refs"
        ],
        "additionalProperties": true
      },
      "minItems": 0
    },
    "results": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "observed",
            "planned",
            "unavailable"
          ]
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          },
          "minItems": 0
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          },
          "minItems": 0
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "status",
        "records",
        "artifacts"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "records": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "limitations": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/record"
        }
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "project_id",
    "title",
    "stage",
    "question",
    "capability_refs",
    "model",
    "inputs",
    "execution",
    "outputs",
    "references",
    "criteria",
    "checks",
    "results",
    "limitations"
  ],
  "additionalProperties": true
}
